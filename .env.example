MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MAILGUN_DOMAIN=
MAILGUN_SECRET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=

WINPAY_PRIVATE_KEY1=
WINPAY_PRIVATE_KEY2=
WINPAY_MERCHANT_KEY=
WINPAY_PRODUCTION=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
