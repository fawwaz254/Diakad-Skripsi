APP_NAME=laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=true
APP_LOG_LEVEL=debug
APP_URL=http://127.0.0.1:8000

APP_TIMEZONE=Asia/Jakarta

